# Use the pooled URL for application requests (for example, a Neon -pooler host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER:5432/DATABASE?sslmode=require"

# Optional direct URL for Prisma migrations. If omitted, DATABASE_URL is used.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
